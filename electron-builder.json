{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.kofc.trackingplatform",
  "productName": "KofC Tracking Platform",
  "copyright": "Knights of Columbus Council 15295",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "apps/desktop/resources"
  },
  "extraMetadata": {
    "main": "apps/desktop/main.cjs"
  },
  "files": [
    "apps/desktop/main.cjs",
    "package.json",
    "!**/node_modules/**/*",
    "!**/*.map"
  ],
  "extraResources": [
    {
      "from": "apps/web/.next/standalone",
      "to": "portal",
      "filter": [
        "**/*",
        "!**/*.map",
        "!**/.next/cache/**",
        "!**/.cache/**",
        "!**/vitest/**",
        "!**/@vitest/**",
        "!**/__tests__/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.tsbuildinfo"
      ]
    }
  ],
  "afterPack": "apps/desktop/after-pack.cjs",
  "asar": true,
  "compression": "maximum",
  "electronLanguages": [
    "en-US"
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "KofC-Tracking-Platform-${version}-portable.${ext}"
  },
  "portable": {
    "artifactName": "KofC-Tracking-Platform-${version}-portable.${ext}"
  },
  "mac": {
    "target": [
      "dir"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Office"
  }
}
