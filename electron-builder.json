{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "org.kofc.trackingplatform",
  "productName": "KofC Tracking Platform",
  "copyright": "Knights of Columbus Council 15295",
  "directories": {
    "output": "dist-desktop",
    "buildResources": "apps/desktop/resources"
  },
  "extraMetadata": {
    "main": "apps/desktop/main.cjs"
  },
  "files": [
    "apps/desktop/main.cjs",
    "package.json",
    "!**/node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "apps/web/.next/standalone",
      "to": "portal",
      "filter": ["**/*"]
    }
  ],
  "afterPack": "apps/desktop/after-pack.cjs",
  "asar": true,
  "npmRebuild": false,
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "artifactName": "KofC-Tracking-Platform-${version}-portable.${ext}"
  },
  "portable": {
    "artifactName": "KofC-Tracking-Platform-${version}-portable.${ext}"
  },
  "mac": {
    "target": ["dir"]
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Office"
  }
}
