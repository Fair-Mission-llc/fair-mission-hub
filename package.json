{
  "name": "kofc-tracking-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:pilot": "node scripts/start-pilot.mjs",
    "hub:archive": "node scripts/hub-archive.mjs",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:mobile:pilot": "node scripts/start-mobile-pilot.mjs",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:web": "npm run build --workspace=apps/web",
    "build:pilot": "node scripts/build-pilot.mjs",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspace=apps/web && npm run typecheck --workspace=apps/mobile"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
